# Wzór zmiennych środowiskowych. Skopiuj do .env (plik jest w .gitignore) i uzupełnij.
# Nigdy nie commituj prawdziwych wartości.

# Ścieżka do pliku konfiguracji (opcjonalnie)
# KRAKENBOT_CONFIG=config/config.yaml

# Tryb live wymaga TAKŻE mode: live w config.yaml. Domyślnie zostaw zakomentowane.
# KRAKENBOT_ALLOW_LIVE=yes

# Kraken: klucz tylko do odczytu (Etap 2)
KRAKEN_READ_API_KEY=
KRAKEN_READ_API_SECRET=
# Kraken: klucz handlowy (od Etapu 4)
KRAKEN_TRADE_API_KEY=
KRAKEN_TRADE_API_SECRET=

# Telegram (Etap 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agenci (Etap 6)
ANTHROPIC_API_KEY=

# CoinGecko, plan Demo (Etap 5)
COINGECKO_API_KEY=
